generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  password  String?
  role      String   @default("guest")
  createdAt DateTime @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  forUser     String
  title       String
  description String
  date        DateTime
  regular     Boolean  @default(false)
  regularDate DateTime?
  createdAt   DateTime @default(now())
}
